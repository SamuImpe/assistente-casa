# Copia questo file con il nome ".env" e compila i valori.
# Il file .env NON va caricato su Git (contiene la tua chiave privata).

# Quale modello usare: "google" (online) oppure "ollama" (locale)
PROVIDER=google

# Chiave API di Google Gemini (si crea gratis su https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelli (puoi lasciare questi valori)
GOOGLE_MODELLO=gemini-3.1-flash-lite
GOOGLE_MODELLO_EMBEDDING=gemini-embedding-001
OLLAMA_MODELLO=qwen2.5:7b
OLLAMA_MODELLO_EMBEDDING=bge-m3
OLLAMA_INDIRIZZO=http://localhost:11434

# Temperatura: vuoto = valore consigliato dal fornitore (per Gemini 3 Google consiglia il default)
TEMPERATURA=

# Memoria delle conversazioni: "ram" (sparisce alla chiusura) o "sqlite" (salvata su file)
MEMORIA_CONVERSAZIONI=ram

# Ricerca nei documenti (RAG)
RAG_NUMERO_PEZZI=4
RAG_SOGLIA_RILEVANZA=0.35
RAG_DIMENSIONE_PEZZO=1000
RAG_SOVRAPPOSIZIONE=150

# Limiti di sicurezza
MAX_PASSI_AGENTE=6
MAX_TURNI_MEMORIA=6

# LangSmith (facoltativo): per vedere ogni passaggio dell'assistente su https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=assistente-casa
